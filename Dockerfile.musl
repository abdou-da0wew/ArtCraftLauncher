FROM rust:1.82-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libwayland-dev \
    libxkbcommon-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libx11-dev \
    libgl1-mesa-dev \
    musl-tools \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-unknown-linux-musl

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY assets ./assets
COPY build.rs ./

RUN cargo build --release --target x86_64-unknown-linux-musl

FROM alpine:latest AS runtime

RUN apk add --no-cache \
    libssl3 \
    libxkbcommon \
    libxcb \
    libxcb-render \
    libxcb-shape \
    libxcb-xfixes \
    libx11 \
    mesa-gl \
    ca-certificates

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/artcraft-launcher /usr/local/bin/artcraft-launcher
COPY --from=builder /app/assets /app/assets

WORKDIR /app

ENTRYPOINT ["artcraft-launcher"]

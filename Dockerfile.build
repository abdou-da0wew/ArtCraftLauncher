FROM ubuntu:20.04 AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libwayland-dev \
    libxkbcommon-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libx11-dev \
    libgl1-mesa-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY assets ./assets
COPY build.rs ./

RUN cargo build --release

FROM ubuntu:20.04 AS runtime

RUN apt-get update && apt-get install -y \
    libssl1.1 \
    libwayland-client0 \
    libxkbcommon0 \
    libxcb-render0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libx11-6 \
    libgl1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/artcraft-launcher /usr/local/bin/artcraft-launcher
COPY --from=builder /app/assets /app/assets

WORKDIR /app

ENTRYPOINT ["artcraft-launcher"]
